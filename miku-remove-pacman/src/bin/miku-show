def load_profiles():
    """Return the real profiles.py if it is installed near this script.

    In the source tree that is ``tools/profiles.py``; in an installed package the
    builders copy it next to the script (``/usr/share/miku-voicebank/bin/``).
    """
    here = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(here, "profiles.py"),                    # next to the script
        os.path.join(here, "..", "profiles.py"),
        os.path.join(here, "..", "..", "tools", "profiles.py"),   # source tree
        os.path.join(here, "..", "..", "..", "tools", "profiles.py"),
    ]
    for candidate in candidates:
        if not os.path.isfile(candidate):
            continue
        try:
            import importlib.util
            spec = importlib.util.spec_from_file_location(
                "miku_profiles", os.path.abspath(candidate))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            if getattr(mod, "PROFILES", None):
                return mod
        except Exception:
            continue
    return None


_PROFILES_MOD = load_profiles()
VOCAB_TOKENS = tuple(sorted(FALLBACK_VOCAB["deb"]))
_TOKEN_RE = re.compile(r"<(PKGTOOL|PKGMGR|PKGEXT|PKGEXTS|REMOVECMD|DBDIR|DBDIR2|"
                       r"DBTYPE|LOCKFILE|LOCKOWNER|VERIFY|STATUSLINE|PURGELINE|"
                       r"STAGE|TRANSACTION|CACHE|CHECK|MEMFILES|CONFIRM|"
                       r"TRANSACTION2|INTEGRITY|COMPLETE|HOOK|DBUPDATE|MEMDEL|"
                       r"IMGERR|IMGWARN|IMGPERM|NOFILE|UNPACK|VERIFY2)>")


def get_profile(name=None):
    """Vocabulary dict for a profile name; unknown names get the deb one."""
    key = str(name or DEFAULT_PROFILE_NAME).strip().lower()
    if _PROFILES_MOD is not None:
        return _PROFILES_MOD.get(key)
    return FALLBACK_VOCAB.get(key, FALLBACK_VOCAB[DEFAULT_PROFILE_NAME])


def default_profile():
    """The profile this package was built for (PROFILE= in show.conf)."""
    return DEFAULT_PROFILE_NAME


def vocab(text: str, profile) -> str:
    """Expand `<TOKEN>` in a scripted line with the profile's words."""
    if "<" not in text:
        return text
    return _TOKEN_RE.sub(
        lambda m: str(profile[m.group(1)]) if profile.get(m.group(1)) is not None
        else m.group(0), text)


def show_end_time(meta, items, media=None, tail: float = TAIL) -> float:
    """When the show is over, in song-file seconds (absolute, like the timeline).

    The lyric timeline only covers the part of the song the source video used:
    its ``# total`` is the length of that *edit*, not of the recording, and the
    shipped mp3 is a good ten seconds longer.  Ending the show there cut the last
    chord off - and, worse, it let the base package's prerm return while the
    conductor was still singing, so apt handed the terminal back mid-song and
    closing it killed the player.  So the clock runs to the end of the recording
    whenever there is one.
    """
    last = max((item[0] for item in items), default=0.0)
    lyric_end = max(meta.get("start", 0.0) + meta.get("total", 0.0), last + 2.0)
    if media:
        return max(lyric_end, media) + tail
    return lyric_end + TAIL_NO_AUDIO


def lyric_span(meta, items, media=None, tail: float = TAIL) -> float:
    """How many seconds the removal lasts, i.e. what the ticks count up to.

    This is the same end as the conductor's, measured from the moment the
    timeline says the music starts, because that is what `publish()` writes into
    the progress file.
    """
    start = meta.get("start", 0.0)
    return max(1.0, show_end_time(meta, items, media, tail) - start)

def load_timeline(path: str):
    """-> (meta, [(audio_time, kind, text)]).

    Times in the file are *audio file* times: the SRT's song timeline shifted by
    the alignment offset that was found for the shipped recording.
    """
    meta = {"start": 0.0, "total": 250.0}
    items = []
    with open(path, "r", encoding="utf-8") as f:
        for raw in f:
            line = raw.rstrip("\n")
            if not line:
                continue
            if line.startswith("#"):
                m = re.match(r"#\s*(start|total|audio offset)\s*:?\s+([-+0-9.]+)", line)
                if m:
                    key = "start" if m.group(1) == "audio offset" else m.group(1)
                    meta[key] = float(m.group(2))
                continue
            parts = line.split("\t")
            if len(parts) >= 3:
                items.append((float(parts[0]), parts[1], parts[2]))
    return meta, items


# --------------------------------------------------------------------------
# the show
# --------------------------------------------------------------------------
#
# The transcript pretends to be the package manager doing the removing, so the
# system chatter has to sound like the machine it runs on: `apt`/`dpkg` on
# Debian, `dnf`/`rpm` on Fedora, `pacman` on Arch.  Everything that differs is a
# `<TOKEN>`; tools/profiles.py holds the vocabularies and the builders stamp the
# right one into the package as PROFILE= in show.conf.

HEADER = [
    ("[VOCALOID] 准备删除已安装的声库", "msg"),
    ("[VOCALOID] 正在准备事务...", "msg"),
    ("[VOCALOID] 正在解析缓存...", "msg"),
    ("[VOCALOID] <CHECK>", "msg"),
    ("[VOCALOID] 以下声库将被移除：", "msg"),
    ("  miku 4.0  [已安装]", "tag"),
    ("  vocaloid-editor 4.0  [不再被其他包需要]", "tag"),
    ("[VOCALOID] <MEMFILES>", "msg"),
    ("[VOCALOID] 总计移除大小：{size}", "msg"),
    ("[VOCALOID] <CONFIRM>", "msg"),
    ("[VOCALOID] <TRANSACTION2>", "msg"),
]

# printed before the song is fetched; the rest starts the clock at t=0
HEADER_TOP = HEADER[:3]
HEADER_REST = HEADER[3:]

PRELUDE = [
    "[VOCALOID] 正在挂载声库镜像 <DBDIR>/miku-4.0<PKGEXT>",
    "[VOCALOID] <VERIFY>",
    "[VOCALOID] 正在读取记忆文件 /usr/share/vocaloid/models/memory/",
    "[VOCALOID] 记忆文件 user.img <IMGPERM>，跳过",
]


def stage_label(profile) -> str:
    """The progress bar's label, e.g. `(1/2) 正在删除 miku`."""
    return "(1/2) " + profile["STAGE"]


def epilogue_lines(profile) -> list:
    return [
        ("(2/2) %s vocaloid-editor [##########] 100%%" % profile["STAGE"], "msg"),
        (profile["HOOK"], "msg"),
        (profile["DBUPDATE"], "msg"),
        ("-> 正在更新图标缓存...", "msg"),
        (profile["COMPLETE"], "tag"),
        ("", "plain"),
        ("[VOCALOID] 声库 miku 4.0 ({ver}) 已从本机移除。", "msg"),
        ("[VOCALOID] " + profile["MEMDEL"], "msg"),
        ("[VOCALOID] 谢谢你… 以及… 晚安…", "msg"),
    ]


GAG = "再一次就好"          # the "just one more time" integrity bar


class Show:
    def __init__(self, cfg, args, out, tty, paint, screen):
        self.cfg = cfg
        self.args = args
        self.out = out
        self.tty = tty
        self.p = paint
        self.s = screen

        self.speed = max(0.01, as_float(cfg.get("SPEED"), 1.0))
        self.profile = get_profile(cfg.get("PROFILE"))
        self.offset = as_float(cfg.get("AUDIO_OFFSET"), 0.0)
        self.a_start = as_float(cfg.get("AUDIO_START"), 0.0)
        self.shift = self.offset - self.a_start   # audio time -> show clock
        self.meta = {"start": 0.0, "total": 250.0}
        self.items = []
        self.audio = None
        self.audio_end = None
        self.media_end = None        # end of the recording in song-file seconds
        self.cursor = 0
        self.song_start = 0.0
        self.total = 250.0
        self.t0 = 0.0
        self._hits = 0
        # orchestration: the conductor publishes progress, the prerms wait on it
        self.stop_early = False
        self._published = 0.0
        self._pings_seen = None
        self.stale_after = as_float(cfg.get("CONDUCTOR_STALE"), 20.0)
        self.progress_path = None
        self.ping_path = None
        self.done_path = None
        self.pid_path = None
        self.claim_path = None

    # -- rendering helpers ----------------------------------------------
    def log(self, text: str, style: str = "msg") -> None:
        if truthy(self.cfg.get("QUIET")):
            return
        fn = {
            "msg": self.p.msg, "lyric": self.p.lyric, "voice": self.p.voice,
            "sys": self.p.sys, "note": self.p.note, "tag": self.p.tag,
            "bank": self.p.tag, "dim": self.p.dim,
        }.get(style)
        self.s.line("  " + (fn(text) if fn else text))

    def show_line(self, kind: str, text: str) -> None:
        if kind == "lyric":
            self.log(text, "lyric")
        elif kind == "voice":
            self.log("> " + text, "voice")
        elif kind == "sys":
            self.log(text, "sys")
        elif kind == "note":
            self.log(text, "note")
        else:
            self.log(text, "msg")

    def bar(self, label: str, pct: float, clock: str = "") -> str:
        pct = max(0.0, min(1.0, pct))
        width = 10
        n = int(round(pct * width))
        text = "%s [%s] %3d%%" % (label, "#" * n + "-" * (width - n), int(pct * 100))
        if clock:
            text += "  " + clock
        return self.p.bar(text)

    def gag_bar(self, revealed: int, pct: int) -> str:
        """The 再一次就好 integrity bar from the video."""
        body = GAG[:revealed] + "-" * (10 - revealed)
        return self.p.bar("(2/2) 正在检查包完整性 [%s] %3d%%" % (body, pct))

    def stamp(self, t: float) -> str:
        t = max(0.0, t)
        total = max(1.0, self.total)
        return "%02d:%02d / %02d:%02d" % (int(t // 60), int(t % 60),
                                          int(total // 60), int(total % 60))

    # -- clock -----------------------------------------------------------
    def now(self) -> float:
        """Current audio-file time."""
        return (time.monotonic() - self.t0) * self.speed

    def wait_for(self, show_seconds: float, tick=None) -> None:
        """Wait until `show_seconds` seconds after playback started."""
        target = show_seconds / self.speed
        while True:
            if self.s.broken:
                # the terminal is gone; nobody is watching, stop singing
                raise KeyboardInterrupt
            if self.stop_early:
                return
            left = target - (time.monotonic() - self.t0)
            if left <= 0:
                return
            if tick:
                tick(self.now())
            self.publish()
            if self.args.calibrate:
                self.poll_keys()
            time.sleep(min(0.05, max(0.0, left)))

    # -- orchestration ---------------------------------------------------
    def publish(self) -> None:
        """Tell the waiting prerms how far the removal has got.

        Also notices when nobody is removing packages any more (a partial
        uninstall, or a transaction that died) and wraps the show up early.
        """
        if not self.progress_path:
            return
        now = time.monotonic()
        if now - self._published < 0.5:
            return
        self._published = now
        write_number(self.progress_path, max(0.0, self.now() - self.song_start))
        if self._pings_seen is None:
            self._pings_seen = os.path.exists(self.ping_path)
        elif not self._pings_seen and os.path.exists(self.ping_path):
            self._pings_seen = True
        if self._pings_seen:
            age = file_age(self.ping_path)
            if age is not None and age > self.stale_after:
                self.stop_early = True

    def wait_until(self, audio_time: float, tick=None) -> None:
        """Wait until `audio_time` in the song file (timeline times are audio times)."""
        self.wait_for(audio_time + self.shift, tick)

    # -- interruption ----------------------------------------------------
    def install_handlers(self) -> None:
        for sig in stop_signals():
            try:
                signal.signal(sig, self.request_stop)
            except (OSError, ValueError):
                pass

    def request_stop(self, signum=None, frame=None) -> None:
        """Ctrl+C x1 = stop the music politely, x2 = kill it, x3 = walk out.

        One press is normally enough; the extra presses are there for the case
        where a player ignores SIGTERM or the terminal is half dead.
        """
        self._hits += 1
        if self._hits >= 3:
            if self.audio:
                self.audio.kill()
            os._exit(130)          # third press: no unwinding, just leave
            return
        if self.audio:
            if self._hits == 1:
                self.audio.stop(grace=2.0)
            else:
                self.audio.kill()
        raise KeyboardInterrupt

    # -- live calibration ------------------------------------------------
    def poll_keys(self) -> None:
        fd = getattr(self, "tty_in_fd", None)
        if fd is None:
            return
        try:
            import select
            while select.select([fd], [], [], 0)[0]:
                ch = os.read(fd, 1)
                if not ch:
                    return
                self.handle_key(ch.decode("utf-8", "replace"))
        except (OSError, ValueError):
            self.tty_in_fd = None

    def handle_key(self, c: str) -> None:
        if c == "[":
            self.offset = round(self.offset - 0.1, 2)
        elif c == "]":
            self.offset = round(self.offset + 0.1, 2)
        elif c == "{":
            self.offset = round(self.offset - 1.0, 2)
        elif c == "}":
            self.offset = round(self.offset + 1.0, 2)
        elif c in ("s", "\r", "\n"):
            self.shift = self.offset - self.a_start
            self.save_offset()
            raise SystemExit(0)
        elif c == "q":
            raise SystemExit(0)
        else:
            return
        self.shift = self.offset - self.a_start
        self.log("AUDIO_OFFSET = %+.2fs   （[ ] 微调 0.1s，{ } 调整 1s，s 保存，q 放弃）"
                 % self.offset, "note")

    def save_offset(self) -> None:
        target = USER_CONF
        try:
            os.makedirs(os.path.dirname(target), exist_ok=True)
            lines = []
            if os.path.isfile(target):
                with open(target, "r", encoding="utf-8") as f:
                    lines = [ln for ln in f.read().splitlines()
                             if not ln.strip().startswith("AUDIO_OFFSET")]
            lines.append("AUDIO_OFFSET=%+.2f" % self.offset)
            with open(target, "w", encoding="utf-8") as f:
                f.write("\n".join(lines) + "\n")
            self.log("已保存到 %s" % target, "note")
        except OSError as exc:
            self.log("保存失败：%s" % exc, "sys")

    # -- phases ----------------------------------------------------------
    def say_hello(self) -> None:
        """The first couple of lines, before the song has to exist."""
        for text, style in HEADER_TOP:
            self.log(vocab(text, self.profile), style)
            time.sleep(0.35 / self.speed)

    def fetch_progress(self, done: int, total: int) -> None:
        if total:
            self.set_status(self.bar("(0/2) 正在获取声库波形", done / float(total),
                                     "%.1f/%.1f MiB" % (done / 1048576.0, total / 1048576.0)))
        else:
            self.set_status(self.bar("(0/2) 正在获取声库波形", 0.0,
                                     "%.1f MiB" % (done / 1048576.0)))

    def prelude(self) -> None:
        size = str(self.cfg.get("TOTAL_SIZE", "5.4 GiB"))
        count = str(self.cfg.get("PACK_COUNT", "51"))
        t = 0.0
        for text, style in HEADER_REST:
            self.wait_until(min(t, max(0.0, self.song_start - 6.0)))
            text = vocab(text, self.profile).replace("{size}", size)
            self.log(text, style)
            t += 0.4
        # the recording opens with a long intro: the uninstaller keeps working
        span = (self.song_start - 3.4) - t
        if span > 0 and PRELUDE:
            gap = span / len(PRELUDE)
            for i, text in enumerate(PRELUDE):
                t += gap
                self.wait_until(min(t, self.song_start - 3.4))
                text = vocab(text, self.profile).replace("{count}", count)
                self.log(text, "msg")
        base = max(t + 0.4, self.song_start - 3.3)
        # the percentages are the ones from the source video
        for i, (revealed, pct) in enumerate(((1, 20), (2, 60), (3, 80), (5, 100))):
            self.wait_until(min(base + 0.8 * i, self.song_start - 0.15))
            self.s.status(self.gag_bar(revealed, pct))
        self.wait_until(self.song_start)
        self.set_status(self.bar(self.stage(), 0.0, self.stamp(0)))

    def stage(self) -> str:
        """`(1/2) 正在删除 miku`, in this package manager's words."""
        return stage_label(self.profile)

    def deletion(self) -> None:
        self.log("%s              [----------]   0%%" % self.stage(), "msg")
        for t, kind, text in self.items[self.cursor:]:
            self.wait_until(t, tick=self.tick)
            if self.stop_early:
                break
            self.show_line(kind, text)
            self.cursor += 1
        if not self.stop_early and self.cursor >= len(self.items):
            # the outro is longer than the transcript: hold "晚安…" on screen so
            # the last thing miku says stays readable until the music dies out
            self.wait_until(self.total - 2.0 - self.shift, tick=self.tick)
        if not self.stop_early:
            self.wait_until(self.song_start + self.total, tick=self.tick)
        self.set_status(self.bar(self.stage(), 1.0,
                                 self.stamp(self.song_start + self.total)))
        self.log("%s             [##########] 100%%" % self.stage(), "msg")

    def tick(self, now_audio: float) -> None:
        done = now_audio - self.song_start
        self.set_status(self.bar(self.stage(), done / max(1.0, self.total),
                                 self.stamp(done)))

    def set_status(self, text: str) -> None:
        self.s.status(text)

    def epilogue(self) -> None:
        size = str(self.cfg.get("TOTAL_SIZE", "5.4 GiB"))
        for text, style in epilogue_lines(self.profile):
            text = text.replace("{ver}", VERSION).replace("{size}", size)
            if not text:
                self.s.line("")
                continue
            self.log(text, style)
            if self.speed < 3:
                time.sleep(0.30 / self.speed)

    # -- driver ----------------------------------------------------------
    def tail(self) -> float:
        """Seconds to keep playing past the last note (AUDIO_TAIL)."""
        return max(0.0, as_float(self.cfg.get("AUDIO_TAIL"), TAIL))

    def show_end(self) -> float:
        """When the show is over, in song-file seconds (see show_end_time)."""
        media = self.media_end or (self.audio_end + self.a_start
                                   if self.audio_end else None)
        return show_end_time(self.meta, self.items, media, self.tail())

    def show_total(self) -> float:
        """Number of song seconds the bar and the package ticks count up to."""
        return max(1.0, self.show_end() - self.song_start)

    def attach_audio(self, audio_path, start: float):
        """Start playback and line the clock up with where it really began."""
        if truthy(self.cfg.get("KILL_STRAY", "1")):
            stop_stray_players(audio_path, lambda m: self.log(m, "sys"))
        dur = media_duration(audio_path)
        self.audio = Audio(audio_path, self.cfg, lambda m: self.log(m, "sys"))
        self.audio.start(start)
        # a player that cannot seek may have fallen back to the file start
        self.a_start = self.audio.actual_start
        self.shift = self.offset - self.a_start
        if dur:
            self.media_end = dur
            self.audio_end = dur - self.a_start
        # the removal bar counts song time, so the trailing notes are part of it
        self.total = self.show_total()

    def run(self, timeline_path: str, audio_path=None) -> int:
        self.install_handlers()
        self.meta, self.items = load_timeline(timeline_path)
        # the timeline keeps the package manager's name as a <TOKEN> so the same
        # file can be shipped by every build; stamp this machine's words in
        self.items = [(t, kind, vocab(text, self.profile))
                      for t, kind, text in self.items]
        self.song_start = self.meta.get("start", 0.0)
        self.total = self.meta.get("total", 250.0)

        self.say_hello()
        if not (truthy(self.cfg.get("NO_AUDIO")) or self.args.no_audio):
            path = audio_path or resolve_audio(
                self.cfg, self.args.audio, self.audio_log,
                progress=self.fetch_progress)
            if path:
                self.attach_audio(path, self.a_start)

        self.t0 = time.monotonic()
        self.publish()
        self.prelude()
        self.deletion()
        if self.stop_early and not truthy(self.cfg.get("QUIET")):
            self.log("[VOCALOID] 卸载已经结束了，停止演出。", "sys")
        self.epilogue()

        end = self.show_end() - self.a_start          # show clock
        if not self.stop_early:
            self.wait_for(end)
        self.finish()
        self.s.close()
        if self.audio:
            self.audio.stop()
            self.audio.kill()
        return 0

    def finish(self) -> None:
        """Let the waiting prerms know the song is over."""
        if self.done_path:
            write_number(self.done_path, time.time())
            write_number(self.progress_path, self.total + 3600.0)
        if self.pid_path:
            try:
                os.unlink(self.pid_path)
            except OSError:
                pass
        if self.claim_path:
            release_conductor({"claim": self.claim_path})

    def audio_log(self, text: str, style: str = "msg") -> None:
        self.log(text, style)


# --------------------------------------------------------------------------
# --check, the once-lock, main
# --------------------------------------------------------------------------

def _conductor_style(cfg) -> str:
    """apt redraws its own progress line at the bottom; do not fight it.

    The show moves to scrolling lines when it is orchestrated, unless the user
    picked a style explicitly.
    """
    style = cfg.get("STATUS_STYLE", "inline")
    return "scroll" if style == DEFAULTS["STATUS_STYLE"] else style


def cmd_check(cfg, timeline_path, audio_path) -> int:
    print("miku-show %s   (miku-voicebank %s)" % (VERSION, VERSION))
    print("  config   : %s" % (cfg.get("_conf") or "(built-in defaults)"))
    print("  timeline : %s" % (timeline_path or "!! not found"))
    if timeline_path:
        meta, items = load_timeline(timeline_path)
        print("             %d lines, music starts at %.2fs, removal lasts %.2fs"
              % (len(items), meta.get("start", 0.0), meta.get("total", 0.0)))
    url = (cfg.get("AUDIO_URL") or "").strip()
    if audio_path:
        print("  audio    : %s" % audio_path)
    elif url:
        dest = os.path.join(cache_dir(cfg) or "?", url_basename(url))
        print("  audio    : (还没下载) %s" % url)
        print("             -> %s" % dest)
    else:
        print("  audio    : !! not found (no local file and AUDIO_URL is empty)")
    if audio_path:
        dur = media_duration(audio_path)
        print("             %.1f MB%s" % (os.path.getsize(audio_path) / 1e6,
                                         (", %.1fs" % dur) if dur else ""))
    picked = pick_player(cfg, as_float(cfg.get("AUDIO_START")),
                         lambda m: print("             " + m), audio_path or url or None)
    print("  player   : %s" % (picked[0] if picked else "none - lyrics only"))
    if picked and picked[0] == "pw-play" and os.path.exists("/mnt/wslg/PulseServer") \
            and not native_pipewire():
        print("  !! WSLg 只提供 PulseAudio，pw-play 需要本机 PipeWire 守护进程，"
              "可能没有声音；建议 sudo apt install mpv 或 PLAYER=paplay")
    if not audio_path and not url:
        print("  !! no audio: lyrics will print in silence")
    return 0


LOCK_DIRS = ["/run/miku-voicebank", "/tmp/.miku-voicebank"]


def state_dir(create: bool = True):
    """Shared scratch space between the prerm ticks and the conductor."""
    for d in LOCK_DIRS:
        try:
            if create:
                os.makedirs(d, exist_ok=True)
            if os.path.isdir(d) and os.access(d, os.W_OK):
                return d
        except OSError:
            continue
    return None


def state_path(name: str):
    d = state_dir(create=name != "done")
    return os.path.join(d, name) if d else None


def read_number(path, default=None):
    try:
        with open(path, "r") as f:
            return float(f.read().strip())
    except (OSError, ValueError):
        return default


def write_number(path, value) -> None:
    if not path:
        return
    try:
        with open(path, "w") as f:
            f.write("%.3f\n" % value)
    except OSError:
        pass


def touch(path) -> None:
    if not path:
        return
    try:
        with open(path, "a"):
            os.utime(path, None)
    except OSError:
        pass


def file_age(path):
    try:
        return time.time() - os.path.getmtime(path)
    except OSError:
        return None


def lock_path():
    return state_path("show.lock")


def once_allowed(duration: float) -> bool:
    """Only the first prerm of a removal transaction runs the ritual.

    The stamp goes stale one minute after the show would have ended, so a later
    removal (or a re-install/remove cycle) sings again.
    """
    path = lock_path()
    if not path:
        return True
    try:
        if time.time() - os.path.getmtime(path) < duration + 60.0:
            return False
    except OSError:
        pass
    try:
        with open(path, "w") as f:
            f.write("%d\n" % int(time.time()))
    except OSError:
        return True
    return True


# --------------------------------------------------------------------------
# orchestration: spread the package removals across the song
# --------------------------------------------------------------------------
#
# `apt remove miku-voicebank-pack` removes 52 packages one after another, and
# dpkg will not touch the next one until the current prerm returns.  If the
# first prerm simply played the whole song, apt's progress bar would sit at 0%
# for five minutes and then jump to 100%.
#
# So the song runs in a detached *conductor* process while each prerm only
# waits for its own moment in the song and then returns - one package really is
# removed every few seconds, and apt's bar creeps up with the lyrics.

def tick_log(paths, message: str) -> None:
    """A tiny breadcrumb trail; the show owns the terminal, so write to a file."""
    path = paths.get("log") if paths else None
    if not path:
        return
    try:
        with open(path, "a") as f:
            f.write("%.3f pid=%d %s\n" % (time.time(), os.getpid(), message))
    except OSError:
        pass


def conductor_paths():
    return {
        "progress": state_path("progress"),
        "ping": state_path("ping"),
        "done": state_path("done"),
        "pid": state_path("pid"),
        "lock": state_path("show.lock"),
        "claim": state_path("conductor.lock"),
        "log": state_path("tick.log"),
    }


def pid_alive(pid) -> bool:
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


def conductor_healthy(paths, stale: float) -> bool:
    """A conductor we can rely on: its pid is alive and it keeps talking."""
    if not pid_alive(read_number(paths["pid"])):
        return False
    for key in ("progress", "pid"):
        age = file_age(paths[key])
        if age is not None and age <= stale:
            return True
    return False


def claim_conductor(paths) -> bool:
    """Single instance: whoever owns conductor.lock is the one singing."""
    owner = read_number(paths["claim"])
    if owner and int(owner) != os.getpid() and pid_alive(owner):
        return False
    write_number(paths["claim"], os.getpid())
    return True


def release_conductor(paths) -> None:
    try:
        os.unlink(paths["claim"])
    except OSError:
        pass


def stray_conductors():
    """Any other --conductor processes (pid file lost, crashed start, ...)."""
    me = os.getpid()
    out = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return out                        # no procfs (not Linux): nothing to do
    for entry in entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                cmd = f.read().decode("utf-8", "replace")
        except OSError:
            continue
        if "--conductor" in cmd and "miku-show" in cmd:
            out.append(pid)
    return out


def kill_pids(pids):
    for sig in (signal.SIGTERM, signal.SIGKILL):
        left = []
        for pid in pids:
            try:
                os.kill(pid, sig)
                left.append(pid)
            except OSError:
                pass
        if not left:
            return
        time.sleep(0.5)
        pids = left


def start_conductor(cfg, args, timeline_path, audio_path, out_fd, paths):
    """Spawn the background show; it prints to the same terminal."""
    argv = [sys.executable, os.path.abspath(__file__), "--conductor",
            "--timeline", timeline_path]
    if audio_path:
        argv += ["--audio", audio_path]
    if args.conf:
        argv += ["--conf", args.conf]
    for flag, value in (("--speed", args.speed), ("--offset", args.offset),
                        ("--start", args.start), ("--status", args.status)):
        if value is not None:
            argv += [flag, str(value)]
    if args.no_audio:
        argv.append("--no-audio")
    if args.no_color:
        argv.append("--no-color")
    # same session and process group on purpose: Ctrl+C and the window closing
    # have to reach the conductor (and, through it, the player)
    devnull = open(os.devnull, "rb")
    try:
        proc = subprocess.Popen(argv, stdin=devnull, stdout=out_fd, stderr=out_fd,
                                close_fds=True)
    except OSError:
        return None
    write_number(paths["pid"], proc.pid)
    return proc


def cmd_tick(cfg, args, timeline_path, audio_path, out, tty) -> int:
    """Called from every prerm: start the song once, then wait my turn."""
    index = int(args.index or 0)
    count = max(1, int(args.count or cfg.get("PACK_COUNT") or 51))
    meta, items = load_timeline(timeline_path)
    # the tick has to count to the same place the conductor does, which is the
    # end of the *recording* - not the shorter span the lyric timeline came from
    total = lyric_span(meta, items,
                       media_duration(audio_path) if audio_path else None,
                       max(0.0, as_float(cfg.get("AUDIO_TAIL"), TAIL)))

    paths = conductor_paths()
    if not paths["progress"] or not truthy(cfg.get("ORCHESTRATE", "1")):
        return run_blocking(cfg, args, timeline_path, audio_path, out, tty,
                            paths.get("lock") if paths else None, total)

    # my turn in the song: pack1 finishes first, the base package last
    if index == 0:                      # the voicebank itself: wait it out
        target = total + 1.0
    else:
        target = (index - 1) * (total / count)

    ping = paths["ping"]
    touch(ping)
    done = paths["done"]
    # The song for *this* removal already finished (the base package arrives
    # after the last chord): do not start another one.  A stale marker means a
    # later removal, which is allowed to sing again.
    age = file_age(done)
    if age is not None and age < 60.0:
        tick_log(paths, "song already played %.0fs ago - nothing to do" % age)
        return 0
    try:
        os.unlink(done)
    except OSError:
        pass

    stale = as_float(cfg.get("CONDUCTOR_STALE"), 20.0)
    # a live conductor that keeps publishing is never duplicated; anything else
    # (crashed start, lost pid file, stale progress) is cleaned up first
    healthy = conductor_healthy(paths, stale)
    tick_log(paths, "index=%s target=%.1f healthy=%s pid=%s p_age=%s pid_age=%s"
             % (index, target, healthy, read_number(paths["pid"]),
                file_age(paths["progress"]), file_age(paths["pid"])))
    if not healthy:
        strays = stray_conductors()
        tick_log(paths, "restarting: killing %s" % strays)
        kill_pids(strays)
        release_conductor(paths)
        proc = start_conductor(cfg, args, timeline_path, audio_path,
                               out.fileno(), paths)
        tick_log(paths, "started conductor pid=%s" % (proc.pid if proc else None))

    stop = {"now": False}

    def on_signal(signum=None, frame=None):
        stop["now"] = True

    for sig in stop_signals():
        try:
            signal.signal(sig, on_signal)
        except (OSError, ValueError):
            pass

    while not stop["now"]:
        if os.path.exists(done):
            break
        p = read_number(paths["progress"])
        if p is not None and p >= target:
            break
        if not pid_alive(read_number(paths["pid"])):
            break
        age = file_age(paths["progress"])
        if p is None and age is None:
            break
        if age is not None and age > stale * 2:
            break
        touch(ping)                     # keep the conductor awake while I wait
        time.sleep(0.4)
    return 0


def run_blocking(cfg, args, timeline_path, audio_path, out, tty, lock, total) -> int:
    """The old behaviour: one prerm plays the whole thing and blocks dpkg."""
    if lock:
        try:
            if time.time() - os.path.getmtime(lock) < total + 60.0:
                return 0
        except OSError:
            pass
        try:
            with open(lock, "w") as f:
                f.write("%d\n" % int(time.time()))
        except OSError:
            pass
    paint = Paint(truthy(cfg.get("COLOR")))
    screen = Screen(out, paint, cfg.get("STATUS_STYLE", "inline"))
    show = Show(cfg, args, out, tty, paint, screen)
    try:
        return show.run(timeline_path, audio_path)
    except KeyboardInterrupt:
        if show.audio:
            show.audio.stop()
            show.audio.kill()
        screen.close()
        return 130
    finally:
        if show.audio:
            show.audio.stop()
            show.audio.kill()


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="miku-show",
        description="播放《初音ミクの消失》，同时输出声库删除过程"
                    "（卸载 miku-voicebank 时由 prerm 调用）")
    ap.add_argument("--audio", help="song file")
    ap.add_argument("--timeline", help="timeline.tsv")
    ap.add_argument("--conf", help="configuration file")
    ap.add_argument("--offset", type=float, help="nudge every lyric line by N seconds")
    ap.add_argument("--start", type=float, help="start playback at N seconds")
    ap.add_argument("--speed", type=float, help="playback/print speed (testing)")
    ap.add_argument("--status", choices=["inline", "scroll", "off"])
    ap.add_argument("--no-audio", action="store_true", help="lyrics only")
    ap.add_argument("--no-color", action="store_true")
    ap.add_argument("--once", action="store_true",
                    help="run at most once per removal transaction (old behaviour)")
    ap.add_argument("--tick", action="store_true",
                    help="prerm entry point: start the song, then wait my turn and return")
    ap.add_argument("--conductor", action="store_true",
                    help="background show process started by --tick")
    ap.add_argument("--index", type=int, default=None,
                    help="this package's place in the chain (0 = the base package)")
    ap.add_argument("--count", type=int, default=None, help="packages in the chain")
    ap.add_argument("--fast", action="store_true", help="print everything at once")
    ap.add_argument("--calibrate", action="store_true",
                    help="play the song and tune AUDIO_OFFSET with [ ] { } s q")
    ap.add_argument("--check", action="store_true", help="report settings, change nothing")
    ap.add_argument("--fetch-audio", action="store_true",
                    help="download the song into the cache and exit (postinst uses this)")
    ap.add_argument("--stop-audio", action="store_true",
                    help="kill any player still singing our song, then exit")
    ap.add_argument("--quiet", action="store_true", help="print as little as possible")
    ap.add_argument("--to-stdout", action="store_true",
                    help="write to stdout even if a terminal is available")
    ap.add_argument("--version", action="version", version="miku-show " + VERSION)
    args = ap.parse_args(argv)

    cfg, conf_used = load_config(args.conf)
    cfg["_conf"] = conf_used
    timeline_path = find_timeline(args.timeline)
    audio_path = find_audio(cfg, args.audio)

    if args.offset is not None:
        cfg["AUDIO_OFFSET"] = str(args.offset)
    if args.start is not None:
        cfg["AUDIO_START"] = str(args.start)
    if args.speed is not None:
        cfg["SPEED"] = str(args.speed)
    if args.status:
        cfg["STATUS_STYLE"] = args.status
    if args.no_audio:
        cfg["NO_AUDIO"] = "1"
    if args.quiet:
        cfg["QUIET"] = "1"
    if args.fast:
        cfg["SPEED"] = str(max(as_float(cfg.get("SPEED"), 1.0), 200.0))
        cfg["NO_AUDIO"] = "1"
        cfg["STATUS_STYLE"] = "off"

    if args.check:
        return cmd_check(cfg, timeline_path, audio_path)
    if args.fetch_audio:
        path = resolve_audio(cfg, args.audio, lambda t, s="msg": None)
        if path and os.path.isfile(path):
            if not truthy(cfg.get("QUIET")):
                print("%s (%.1f MiB)" % (path, os.path.getsize(path) / 1048576.0))
            return 0
        return 1
    if args.stop_audio:
        pids = stray_players(audio_path)
        if not pids:
            print("没有正在播放的 miku-voicebank 进程。")
            return 0
        stop_stray_players(audio_path, lambda m: print(m))
        return 0
    if not timeline_path:
        sys.stderr.write("miku-show: timeline.tsv not found\n")
        return 1

    out, tty = open_output(args.to_stdout)
    forced = truthy(cfg.get("FORCE"))
    if not tty and not forced:
        # no terminal to draw on: never hold dpkg for five minutes
        cfg["SPEED"] = str(max(as_float(cfg.get("SPEED"), 1.0), 200.0))
        cfg["NO_AUDIO"] = "1"
        cfg["STATUS_STYLE"] = "off"
    if not tty or args.no_color or os.environ.get("NO_COLOR"):
        cfg["COLOR"] = "0"

    if args.tick:
        if not tty and not forced:
            # nobody is watching: do not orchestrate, just print it all at once
            return run_blocking(cfg, args, timeline_path, audio_path, out, tty,
                                lock_path(), 0.0)
        return cmd_tick(cfg, args, timeline_path, audio_path, out, tty)

    if args.once:
        meta, _ = load_timeline(timeline_path)
        dur = (meta.get("start", 0.0) + meta.get("total", 250.0)) / max(
            0.01, as_float(cfg.get("SPEED"), 1.0))
        if not once_allowed(dur):
            return 0

    if args.conductor:
        paths = conductor_paths()
        if not claim_conductor(paths):
            return 0                      # somebody else is already singing
        cfg["STATUS_STYLE"] = _conductor_style(cfg)

    paint = Paint(truthy(cfg.get("COLOR")))
    screen = Screen(out, paint, cfg.get("STATUS_STYLE", "inline"))
    show = Show(cfg, args, out, tty, paint, screen)
    if args.conductor:
        paths = conductor_paths()
        show.progress_path = paths["progress"]
        show.ping_path = paths["ping"]
        show.done_path = paths["done"]
        show.pid_path = paths["pid"]
        show.claim_path = paths["claim"]
        write_number(paths["progress"], 0.0)
        touch(paths["ping"])
        try:
            os.unlink(paths["done"])
        except OSError:
            pass

    saved = None
    if args.calibrate:
        try:
            import termios
            fd = os.open("/dev/tty", os.O_RDONLY | os.O_NONBLOCK)
            saved = (fd, termios.tcgetattr(fd))
            attrs = termios.tcgetattr(fd)
            attrs[3] &= ~(termios.ICANON | termios.ECHO)
            attrs[6][termios.VMIN] = 0
            attrs[6][termios.VTIME] = 0
            termios.tcsetattr(fd, termios.TCSANOW, attrs)
            show.tty_in_fd = fd
        except Exception as exc:
            sys.stderr.write("无法进入校准模式：%s\n" % exc)
            saved = None

    code = 0
    try:
        code = show.run(timeline_path, audio_path)
    except KeyboardInterrupt:
        if show.audio:
            show.audio.stop()
            show.audio.kill()
        screen.close()
        code = 130
    except SystemExit as exc:
        code = int(exc.code or 0)
    finally:
        if show.audio:
            show.audio.stop()
            show.audio.kill()
        if saved:
            try:
                import termios
                termios.tcsetattr(saved[0], termios.TCSANOW, saved[1])
                os.close(saved[0])
            except Exception:
                pass
    return code


if __name__ == "__main__":
    sys.exit(main())
