        "VERIFY": "pacman: 正在校验 .MTREE...",
        "STAGE": "正在删除 miku",
        "CHECK": "正在检查软件包依赖关系...",
        "MEMFILES": "将额外执行：删除 pacman 所管理的记忆文件（--nosave）",
        "CONFIRM": "确认执行这些操作？[Y/n] y",
        "TRANSACTION2": "正在执行事务...",
        "HOOK": "正在运行 pacman 钩子 vocaloid_remove...",
        "DBUPDATE": "-> 正在更新 pacman 本地数据库...",
        "COMPLETE": ":: 卸载操作完成！",
        "MEMDEL": "记忆文件（--nosave）已删除：{size}",
        "IMGPERM": "权限有误（只读）",
