#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""miku-show - the VOCALOID voicebank removal ritual.

Runs from the prerm of every ``miku-voicebank-pack*`` package: it plays
初音ミクの消失 (Hatsune Miku no Shoushitsu) while printing the removal
transcript the voicebank leaves behind - which is, after all, what that song is
about: a voicebank that knows it is being deleted, and goes on singing anyway.

    miku-show                 # the full show (what `apt remove` triggers)
    miku-show --check         # report player / audio / timeline, change nothing
    miku-show --calibrate     # play the song and nudge AUDIO_OFFSET live
    miku-show --no-audio      # lyrics only  (same as MIKU_NO_AUDIO=1)
    miku-show --speed 40      # fast-forward, for testing

Stdlib only, because this has to survive inside dpkg.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import unicodedata

VERSION = "3.9.1"
PACKAGE = "miku-voicebank"

# How long the show runs past the last note.  The removal transcript needs a
# moment to finish printing after the music stops, and the player must never be
# cut off while the recording still has something to say.
TAIL = 1.5
TAIL_NO_AUDIO = 6.0

HERE = os.path.dirname(os.path.abspath(__file__))
SHARE = os.path.dirname(HERE)

DEFAULT_CONF = "/etc/%s/show.conf" % PACKAGE
USER_CONF = os.path.join(os.path.expanduser("~"), ".config", PACKAGE, "show.conf")
TIMELINE_CANDIDATES = [
    os.path.join(SHARE, "timeline.tsv"),
    os.path.join(SHARE, "data", "timeline.tsv"),          # in-tree, for development
    "/usr/share/%s/timeline.tsv" % PACKAGE,
]
AUDIO_DIRS = [
    os.path.join(SHARE, "audio"),
    os.path.join(SHARE, "..", "assets"),                  # in-tree, for development
    "/usr/share/%s/audio" % PACKAGE,
]
AUDIO_EXT = (".flac", ".wav", ".ogg", ".oga", ".opus", ".mp3", ".m4a", ".aac")

# where a downloaded song is cached (first writable one wins)
CACHE_DIRS = [
    "/var/cache/miku-voicebank",
    os.path.join(os.path.expanduser("~"), ".cache", "miku-voicebank"),
    "/tmp/miku-voicebank-cache",
]

#: the package manager whose vocabulary the transcript uses unless PROFILE says
#: otherwise.  Each build of the packages stamps its own (see tools/profiles.py).
DEFAULT_PROFILE_NAME = "pacman"

DEFAULTS = {
    "PROFILE": DEFAULT_PROFILE_NAME,   # which package manager's words to use
    "AUDIO": "",                 # local song file; empty = look in AUDIO_DIRS
    "AUDIO_URL": "",             # ...or fetch it from here (mp3/ogg/flac/...)
    "AUDIO_CACHE": "",           # where the download is kept (default: CACHE_DIRS)
    "AUDIO_FETCH_TIMEOUT": "30",
    "AUDIO_FETCH_RETRIES": "2",
    "PLAYER": "auto",            # auto | mpv | ffplay | cvlc | mpg123 | mplayer | pw-play | paplay | play | aplay | none
    "AUDIO_START": "0",          # where in the file the show begins (seconds)
    "AUDIO_OFFSET": "0",         # runtime nudge for every lyric line (seconds)
    "AUDIO_TAIL": "1.5",         # keep playing this long after the last note
    "NO_AUDIO": "0",
    "AUDIO_VOLUME": "",          # 0-100, used by players that take a volume flag
    "STATUS_STYLE": "inline",    # inline | scroll | off
    "COLOR": "1",
    "SPEED": "1.0",              # 1 = real time (testing only)
    "FORCE": "0",                # 1 = run the full show even without a terminal
    "PACK_COUNT": "51",
    "TOTAL_SIZE": "5.4 GiB",
    "QUIET": "0",
    "KILL_STRAY": "1",           # stop leftover players before starting a new one
    "ORCHESTRATE": "1",          # spread the removal over the song (see --tick)
    "CONDUCTOR_STALE": "20",     # give up on a silent conductor after N seconds
}

# --------------------------------------------------------------------------
# terminal toolkit
# --------------------------------------------------------------------------

RESET = "\033[0m"


class Paint:
    """256-colour styles; everything degrades to plain text when off."""

    def __init__(self, enabled: bool):
        self.on = enabled

    def _c(self, code: str) -> str:
        return "\033[%sm" % code if self.on else ""

    def _w(self, code: str, s: str) -> str:
        return ("\033[%sm" % code + s + RESET) if self.on else s

    def tag(self, s):      # the [VOCALOID] marker / drum machine
        return self._w("38;5;44", s)

    def msg(self, s):      # VOCALOID chatter
        return self._w("38;5;51", s)

    def lyric(self, s):    # the song
        return self._w("38;5;231", s)

    def voice(self, s):    # miku talking to the master
        return self._w("38;5;222", s)

    def sys(self, s):      # deleted files, kill(1), kernel spam
        return self._w("38;5;203", s)

    def note(self, s):     # section banners
        return self._w("38;5;170", s)

    def dim(self, s):
        return self._w("38;5;244", s)

    def bar(self, s):
        return self._w("38;5;48", s)


def dwidth(s: str) -> int:
    """Display width, so the progress bar does not jitter on CJK text."""
    w = 0
    for ch in s:
        if unicodedata.combining(ch):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def clip(s: str, cols: int) -> str:
    if cols <= 0:
        return s
    out, w = [], 0
    for ch in s:
        cw = dwidth(ch)
        if w + cw > cols:
            break
        out.append(ch)
        w += cw
    return "".join(out)


class Screen:
    """Scrolling lines with one live status line kept at the bottom.

    If the terminal goes away (window closed, pipe reader gone) every write
    fails with EIO/EPIPE; that must never take the removal down with it, so the
    stream is simply marked broken and the show ends early.
    """

    def __init__(self, stream, paint: Paint, style: str = "inline"):
        self.f = stream
        self.p = paint
        self.style = style
        self.broken = False
        self._status = ""
        self._drawn = False

    def cols(self) -> int:
        try:
            return shutil.get_terminal_size((100, 30)).columns
        except Exception:
            return 100

    def _write(self, s: str) -> None:
        if self.broken:
            return
        try:
            self.f.write(s)
            self.f.flush()
        except (OSError, ValueError):
            self.broken = True

    def line(self, s: str = "") -> None:
        self._erase()
        self._write(s + "\n")
        self._draw()

    def status(self, s: str) -> None:
        if s == self._status:
            # scroll mode prints one line per change, so an unchanged status
            # must not spit out another one
            if self.style == "scroll" or self._drawn:
                return
        self._status = s
        if self.style == "scroll":
            self._erase()
            self._write(s + "\n")
        elif self.style != "off":
            self._draw()

    def _erase(self) -> None:
        if self._drawn:
            self._write("\r\033[K")
            self._drawn = False

    def _draw(self) -> None:
        if not self._status or self.style != "inline" or self.broken:
            return
        self._write("\r\033[K" + clip(self._status, self.cols() - 1))
        self._drawn = True

    def close(self) -> None:
        self._erase()
        self._write("\n")


def open_output(to_stdout: bool = False):
    """Return (stream, is_tty).

    Normally the terminal we inherit from apt is already the right place.  If a
    maintainer script ever runs with its stdout swallowed by a pipe, fall back
    to /dev/tty so the removal can still be watched.
    """
    if to_stdout or sys.stdout.isatty() or os.environ.get("MIKU_STDOUT"):
        return sys.stdout, sys.stdout.isatty()
    if os.environ.get("DPKG_MAINTSCRIPT_PACKAGE") or os.environ.get("MIKU_TTY"):
        try:
            return open("/dev/tty", "w", buffering=1, encoding="utf-8",
                        errors="replace"), True
        except OSError:
            pass
    return sys.stdout, False


# --------------------------------------------------------------------------
# configuration
# --------------------------------------------------------------------------

def read_conf(path: str) -> dict:
    out = {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip().upper()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def load_config(explicit):
    cfg = dict(DEFAULTS)
    used = None
    for p in [explicit, os.environ.get("MIKU_CONF"), USER_CONF, DEFAULT_CONF]:
        if p and os.path.isfile(p):
            cfg.update(read_conf(p))
            used = p
            break
    for k in DEFAULTS:
        env = os.environ.get("MIKU_" + k)
        if env is not None:
            cfg[k] = env
    return cfg, used


def truthy(v) -> bool:
    return str(v).strip().lower() in ("1", "yes", "true", "on")


def as_float(v, default=0.0) -> float:
    try:
        return float(str(v).strip())
    except (TypeError, ValueError):
        return default


def flac_duration(path: str):
    """Song length straight out of STREAMINFO - no decoder needed."""
    try:
        with open(path, "rb") as f:
            head = f.read(42)
        if head[:4] != b"fLaC":
            return None
        body = head[8:42]
        bits = int.from_bytes(body[10:18], "big")
        rate = (bits >> 44) & 0xFFFFF
        total = bits & 0xFFFFFFFFF
        return total / rate if rate else None
    except OSError:
        return None


MP3_BITRATES = (None, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, None)
MP3_RATES = (44100, 48000, 32000, None)


def mp3_duration(path: str):
    """Walk MPEG-1 Layer III frames - an mp3 has no header to read."""
    try:
        with open(path, "rb") as f:
            head = f.read(10)
            pos = 0
            if head[:3] == b"ID3":
                pos = 10 + (((head[6] & 0x7F) << 21) | ((head[7] & 0x7F) << 14) |
                            ((head[8] & 0x7F) << 7) | (head[9] & 0x7F))
            f.seek(pos)
            data = f.read()
    except OSError:
        return None
    total = 0.0
    i, n = 0, len(data)
    while i + 4 <= n:
        if data[i] != 0xFF or (data[i + 1] & 0xE0) != 0xE0:
            i += 1
            continue
        h = data[i:i + 4]
        ver, layer = (h[1] >> 3) & 3, (h[1] >> 1) & 3
        bri, sri, pad = (h[2] >> 4) & 0xF, (h[2] >> 2) & 3, (h[2] >> 1) & 1
        if ver != 3 or layer != 1 or bri in (0, 15) or sri == 3:
            i += 1
            continue
        flen = int(144 * MP3_BITRATES[bri] * 1000 / MP3_RATES[sri]) + pad
        if flen <= 4:
            i += 1
            continue
        total += 1152 / MP3_RATES[sri]
        i += flen
    return total or None


def media_duration(path: str):
    ext = os.path.splitext(path)[1].lower()
    if ext == ".flac":
        dur = flac_duration(path)
        if dur:
            return dur
    if ext in (".mp3", ".mp2", ".mpa"):
        dur = mp3_duration(path)
        if dur:
            return dur
    try:
        import wave
        with wave.open(path, "rb") as w:
            return w.getnframes() / float(w.getframerate())
    except Exception:
        return None


# --------------------------------------------------------------------------
# fetching the song (so the repo never has to ship it)
# --------------------------------------------------------------------------

def ensure_dir(path: str) -> bool:
    try:
        os.makedirs(path, exist_ok=True)
        return os.access(path, os.W_OK)
    except OSError:
        return False


def cache_dir(cfg=None):
    explicit = (cfg or {}).get("AUDIO_CACHE") or ""
    for d in ([explicit] if explicit else []) + CACHE_DIRS:
        if ensure_dir(d):
            return d
    return None


def url_basename(url: str) -> str:
    name = os.path.basename(url.split("?")[0].split("#")[0]) or "song.mp3"
    return re.sub(r"[^0-9A-Za-z._\-\u4e00-\u9fff]", "_", name)


def download_audio(url: str, dest: str, log, progress=None,
                   timeout: float = 30.0, retries: int = 2) -> bool:
    """Download `url` to `dest` atomically.  Returns True on success."""
    import urllib.request
    tmp = dest + ".part"
    for attempt in range(1, int(retries) + 2):
        try:
            req = urllib.request.Request(
                url, headers={"User-Agent": "miku-voicebank/%s" % VERSION})
            with urllib.request.urlopen(req, timeout=timeout) as resp, open(tmp, "wb") as f:
                total = int(resp.headers.get("Content-Length") or 0)
                done = 0
                while True:
                    chunk = resp.read(262144)
                    if not chunk:
                        break
                    f.write(chunk)
                    done += len(chunk)
                    if progress:
                        progress(done, total)
            if os.path.getsize(tmp) < 1024:
                raise IOError("下载内容过短")
            os.replace(tmp, dest)
            return True
        except Exception as exc:
            log("第 %d 次获取失败：%s" % (attempt, exc), "sys")
            try:
                os.unlink(tmp)
            except OSError:
                pass
            if attempt > retries:
                return False
            time.sleep(1.5)
    return False


def resolve_audio(cfg, explicit, log, progress=None, allow_download=True):
    """Find the song: explicit path > configured path > shipped file > cache > URL.

    `log(text, style)` is called for anything worth printing.
    """
    for p in [explicit, cfg.get("AUDIO")]:
        if p and os.path.isfile(p):
            return p
    for d in AUDIO_DIRS:
        if os.path.isdir(d):
            for name in sorted(os.listdir(d)):
                if name.lower().endswith(AUDIO_EXT):
                    return os.path.join(d, name)

    url = (cfg.get("AUDIO_URL") or "").strip()
    if not url:
        return None
    cdir = cache_dir(cfg)
    if not cdir:
        log("没有可写的缓存目录，无法下载歌曲", "sys")
        return None
    dest = os.path.join(cdir, url_basename(url))
    if os.path.isfile(dest) and os.path.getsize(dest) > 1024:
        return dest
    if not allow_download:
        return None
    log("正在从网络获取声库波形：%s" % url, "msg")
    ok = download_audio(url, dest, log, progress,
                        as_float(cfg.get("AUDIO_FETCH_TIMEOUT"), 30.0),
                        as_float(cfg.get("AUDIO_FETCH_RETRIES"), 2))
    if ok:
        log("声库波形已就绪：%s（%.1f MiB）" % (dest, os.path.getsize(dest) / 1048576.0), "msg")
        return dest
    log("获取失败，本次只输出歌词（也可以手动把音频放进 %s）" % cdir, "sys")
    return None


def find_audio(cfg, explicit):
    """Backwards-compatible name used by --check: never downloads."""
    return resolve_audio(cfg, explicit, lambda text, style="msg": None,
                         allow_download=False)


# --------------------------------------------------------------------------
# audio playback
# --------------------------------------------------------------------------
#   name, binary, argv builder(audio, start, volume), supports seeking, formats
EVERYTHING = AUDIO_EXT
PLAYERS = [
    ("mpv", "mpv",
     lambda a, t, v: ["mpv", "--no-video", "--really-quiet", "--no-terminal"]
     + (["--start=%.3f" % t] if t else []) + (["--volume=%s" % v] if v else []) + [a],
     True, EVERYTHING),
    ("ffplay", "ffplay",
     lambda a, t, v: ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet"]
     + (["-ss", "%.3f" % t] if t else []) + (["-volume", str(v)] if v else []) + [a],
     True, EVERYTHING),
    ("cvlc", "cvlc",
     lambda a, t, v: ["cvlc", "--intf", "dummy", "--play-and-exit", "--no-video"]
     + (["--start-time=%.3f" % t] if t else []) + [a],
     True, EVERYTHING),
    ("mplayer", "mplayer",
     lambda a, t, v: ["mplayer", "-really-quiet", "-nolirc"]
     + (["-ss", "%.3f" % t] if t else []) + [a],
     True, EVERYTHING),
    ("mpg123", "mpg123",
     lambda a, t, v: ["mpg123", "-q"] + (["-k", str(int(t * 38.28))] if t else []) + [a],
     True, (".mp3", ".mp2", ".mpa")),
    ("play", "play",
     lambda a, t, v: ["play", "-q", a] + (["trim", "%.3f" % t] if t else []),
     False, (".mp3", ".flac", ".ogg", ".wav")),
    ("pw-play", "pw-play", lambda a, t, v: ["pw-play", a], False,
     (".wav", ".flac", ".ogg", ".opus")),
    ("paplay", "paplay", lambda a, t, v: ["paplay", a], False,
     (".wav", ".flac", ".ogg")),
    ("aplay", "aplay", lambda a, t, v: ["aplay", "-q", a], False, (".wav",)),
]


def wslg_env() -> dict:
    """WSLg exposes a PulseAudio socket; players have to be told about it."""
    env = dict(os.environ)
    if not env.get("PULSE_SERVER") and os.path.exists("/mnt/wslg/PulseServer"):
        env["PULSE_SERVER"] = "unix:/mnt/wslg/PulseServer"
        env.setdefault("PULSE_RUNTIME_PATH", "/mnt/wslg/runtime-dir")
    return env


def native_pipewire() -> bool:
    """Is there a real PipeWire daemon of our own (as opposed to WSLg's pulse)?"""
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    return os.path.exists(os.path.join(runtime, "pipewire-0"))


def pick_player(cfg, start: float, log, audio_path=None):
    """Pick a player that can actually decode `audio_path` (aplay cannot do mp3)."""
    want = (cfg.get("PLAYER") or "auto").strip().lower()
    if want in ("none", "off", "0", "no"):
        return None
    ext = os.path.splitext(audio_path)[1].lower() if audio_path else None
    order = list(PLAYERS)
    if os.path.exists("/mnt/wslg/PulseServer") and not native_pipewire():
        # WSLg only offers a PulseAudio socket; pw-play talks the native
        # PipeWire protocol and would sit there in silence.
        order.sort(key=lambda p: p[0] == "pw-play")
    found = [(n, b, f, s) for (n, b, f, s, fmts) in order
             if want in ("auto", n) and shutil.which(b)
             and (ext is None or ext in fmts)]
    if not found:
        if ext:
            log("没有能播放 %s 的播放器（mpv / ffplay / vlc / mpg123 都可以）" % ext)
            log("装上任意一个就能听到声音：sudo apt install mpv")
        else:
            log("没有找到可用的音频播放器")
        return None
    if start > 0:
        for p in found:
            if p[3]:
                return p
    return found[0]


def _arm_pdeathsig(expected_ppid: int):
    """Child-side setup: die with the parent (Linux PR_SET_PDEATHSIG).

    Runs after fork(), before exec().  Without this, a player that outlives the
    show keeps singing to a terminal that no longer exists.
    """
    try:
        import ctypes
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        PR_SET_PDEATHSIG = 1
        libc.prctl(PR_SET_PDEATHSIG, int(signal.SIGTERM), 0, 0, 0)
        if os.getppid() != expected_ppid:      # parent died in the meantime
            os._exit(0)
    except Exception:
        pass


class Audio:
    def __init__(self, path: str, cfg: dict, log):
        self.path = path
        self.cfg = cfg
        self.log = log
        self.proc = None
        self.name = None
        self.actual_start = 0.0      # where playback really began

    def start(self, start: float) -> None:
        picked = pick_player(self.cfg, start, self.log, self.path)
        if not picked:
            return
        name, _binary, build, seek = picked
        if start > 0 and not seek:
            self.log("%s 不能从中间起播，改从头播放整首" % name)
            start = 0.0
        self.actual_start = start
        argv = build(self.path, start, self.cfg.get("AUDIO_VOLUME") or "")
        # Deliberately *not* start_new_session: the player has to stay in our
        # process group, so Ctrl+C and the window closing reach it as well.
        hook = None
        if os.name == "posix":
            import functools
            hook = functools.partial(_arm_pdeathsig, os.getpid())
        try:
            self.proc = subprocess.Popen(
                argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL, env=wslg_env(), preexec_fn=hook)
            self.name = name
        except OSError as exc:
            self.log("启动 %s 失败：%s" % (name, exc))
            self.proc = None
            self.actual_start = 0.0

    def alive(self) -> bool:
        return self.proc is not None and self.proc.poll() is None

    def stop(self, grace: float = 1.5) -> None:
        """Ask the player to quit (SIGTERM), then insist (SIGKILL)."""
        if not self.alive():
            return
        try:
            self.proc.terminate()
            self.proc.wait(timeout=grace)
        except Exception:
            self.kill()

    def kill(self) -> None:
        if not self.alive():
            return
        try:
            self.proc.kill()
            self.proc.wait(timeout=1.0)
        except Exception:
            pass


def stray_players(audio_path=None):
    """PIDs of player processes still chewing on our song, found via /proc."""
    keys = ["miku-voicebank/audio"]
    if audio_path:
        keys.append(os.path.realpath(audio_path))
        keys.append(os.path.basename(audio_path))
    me = os.getpid()
    found = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return found                      # no procfs (not Linux): nothing to do
    for entry in entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                cmd = f.read().decode("utf-8", "replace")
        except OSError:
            continue
        if not cmd or "miku-show" in cmd:      # never kill the show itself
            continue
        if any(k and k in cmd for k in keys):
            found.append(pid)
    return found


def stop_stray_players(audio_path, log, quiet=False):
    pids = stray_players(audio_path)
    if not pids:
        return []
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    time.sleep(0.8)
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    if not quiet:
        log("已经停掉还在播放的旧进程：%s" % " ".join(str(p) for p in pids))
    return pids


def stop_signals():
    """The signals that should end the show on this platform."""
    names = ("SIGINT", "SIGTERM", "SIGHUP")
    return tuple(getattr(signal, n) for n in names if hasattr(signal, n))


# --------------------------------------------------------------------------
# timeline
# --------------------------------------------------------------------------

def find_timeline(explicit):
    for p in [explicit] + TIMELINE_CANDIDATES:
        if p and os.path.isfile(p):
            return p
    return None


# --------------------------------------------------------------------------
# the package-manager vocabulary
# --------------------------------------------------------------------------
#
# miku-show ships together with tools/profiles.py (the builders copy it next to
# this script), so that is the single source of truth.  The fallback below only
# exists so a lone `miku-show` still runs; keep it in sync if a token is added.

FALLBACK_VOCAB = {
    "deb": {
        "name": "deb", "family": "Debian / Ubuntu", "PKGMGR": "apt",
        "PKGEXT": ".deb", "DBDIR": "/var/lib/dpkg",
